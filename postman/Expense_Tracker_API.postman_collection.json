{
  "info": {
    "_postman_id": "c1f7b8e0-1234-4567-89ab-auspifyexp01",
    "name": "FinFlow Expense Tracker API",
    "description": "Comprehensive Postman Collection for testing all REST API endpoints of the Expense Tracker Web Application (Auspify Technologies Full Stack Internship).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
